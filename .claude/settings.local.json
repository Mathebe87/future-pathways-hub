{
  "permissions": {
    "allow": [
      "Bash(grep \"\\\\.tsx$\")",
      "Bash(grep -E \"\\\\.tsx$\")",
      "Bash(npx tsc *)",
      "PowerShell(npx tsc --noEmit)",
      "PowerShell(npx tsc --noEmit; Write-Output \"EXIT_CODE: $LASTEXITCODE\")",
      "PowerShell(npx tsc --noEmit; Write-Output \"EXIT=$LASTEXITCODE\")",
      "Bash(echo \"EXIT: $?\")",
      "Bash(echo \"TSC_EXIT_CODE: $?\")",
      "PowerShell(if \\($?\\) { \"TSC_EXIT_OK\" } else { \"TSC_EXIT_FAIL\" })",
      "PowerShell(\"---STATUS---\")"
    ]
  }
}
